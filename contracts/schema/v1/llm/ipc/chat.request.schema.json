{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendesk://llm/ipc/chat.request/v1",
  "title": "llm/ipc/chat.request",
  "type": "object",
  "required": ["messages", "provider"],
  "properties": {
    "messages": {
      "type": "array",
      "items": {
        "$ref": "../message.schema.json"
      }
    },
    "provider": {
      "$ref": "../provider.schema.json"
    },
    "trace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
