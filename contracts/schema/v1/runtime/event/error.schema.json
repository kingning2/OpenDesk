{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://runtime/event/error/v1",
  "title": "runtime/event/error",
  "type": "object",
  "required": ["event_id", "occurred_at", "kind", "message"],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": ["network", "ipc", "code"]
    },
    "stage": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
