{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendesk://workflow/dto/workflow_script/v1",
  "title": "workflow/dto/workflow_script",
  "description": "Workflow script-snippet DTO.",
  "type": "object",
  "required": [
    "id",
    "tags_json",
    "content",
    "needs_boss_input",
    "sort_order",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": { "type": "string" },
    "stage": { "type": "string" },
    "category_l1": { "type": "string" },
    "category_l2": { "type": "string" },
    "trigger_text": { "type": "string" },
    "description": { "type": "string" },
    "from_stage": { "type": "string" },
    "to_stage": { "type": "string" },
    "tags_json": { "type": "string", "description": "JSON array of tag strings." },
    "content": { "type": "string" },
    "needs_boss_input": { "type": "boolean" },
    "boss_input_hint": { "type": "string" },
    "sort_order": { "type": "integer" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": false
}
