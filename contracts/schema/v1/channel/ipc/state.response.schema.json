{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://channel/ipc/state.response/v1",
  "title": "channel/ipc/state.response",
  "type": "object",
  "required": ["accounts", "conversations", "messages", "settings"],
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "../account.schema.json"
      }
    },
    "conversations": {
      "type": "array",
      "items": {
        "$ref": "../conversation.schema.json"
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "$ref": "../message.schema.json"
      }
    },
    "settings": {
      "$ref": "../settings.schema.json"
    }
  },
  "additionalProperties": false
}
