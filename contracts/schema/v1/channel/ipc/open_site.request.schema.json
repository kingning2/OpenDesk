{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendesk://channel/ipc/open_site.request/v1",
  "title": "channel/ipc/open_site.request",
  "type": "object",
  "required": ["account_id", "x", "y", "width", "height"],
  "properties": {
    "account_id": {
      "type": "string",
      "description": "渠道账号 id（用于读取 credential / cookies）"
    },
    "x": {
      "type": "number",
      "description": "相对主窗口客户区的逻辑 X（CSS 像素）"
    },
    "y": {
      "type": "number",
      "description": "相对主窗口客户区的逻辑 Y（CSS 像素）"
    },
    "width": {
      "type": "number",
      "description": "内嵌区域逻辑宽度"
    },
    "height": {
      "type": "number",
      "description": "内嵌区域逻辑高度"
    }
  },
  "additionalProperties": false
}
