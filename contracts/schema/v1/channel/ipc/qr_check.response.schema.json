{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendesk://channel/ipc/qr_check.response/v1",
  "title": "channel/ipc/qr_check.response",
  "type": "object",
  "required": ["ok", "status"],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "cookies": {
      "type": "array",
      "items": {
        "$ref": "../cookie.schema.json"
      }
    },
    "detail": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
