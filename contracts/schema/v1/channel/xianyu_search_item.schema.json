{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://channel/xianyu_search_item/v1",
  "title": "channel/xianyu_search_item",
  "type": "object",
  "required": ["itemId", "title", "url"],
  "properties": {
    "itemId": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": "string" },
    "image": { "type": "string" },
    "price": { "type": "object", "additionalProperties": true },
    "location": { "type": "string" },
    "seller": { "type": "object", "additionalProperties": true },
    "wantCount": { "type": "string" },
    "publishedAt": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
