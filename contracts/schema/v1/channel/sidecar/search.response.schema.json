{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://channel/sidecar/search.response/v1",
  "title": "channel/sidecar/search.response",
  "type": "object",
  "required": ["ok", "status", "keyword", "total", "offers"],
  "properties": {
    "ok": { "type": "boolean" },
    "status": { "type": "string" },
    "keyword": { "type": "string" },
    "total": { "type": "integer" },
    "total_before_filter": { "type": "integer" },
    "offers": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "../ali1688_search_offer.schema.json" },
          { "$ref": "../xianyu_search_item.schema.json" }
        ]
      }
    },
    "final_url": { "type": "string" },
    "detail": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
