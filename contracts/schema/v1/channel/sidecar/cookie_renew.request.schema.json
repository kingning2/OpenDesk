{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://channel/sidecar/cookie_renew.request/v1",
  "title": "channel/sidecar/cookie_renew.request",
  "type": "object",
  "required": ["account_id", "cookies"],
  "properties": {
    "account_id": {
      "type": "string"
    },
    "cookies": {
      "type": "array",
      "items": {
        "$ref": "../cookie.schema.json"
      }
    },
    "punish_url": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
