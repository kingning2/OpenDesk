{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://channel/sidecar/search.request/v1",
  "title": "channel/sidecar/search.request",
  "type": "object",
  "required": ["account_id", "keyword", "cookies"],
  "properties": {
    "account_id": { "type": "string" },
    "keyword": { "type": "string" },
    "cookies": {
      "type": "array",
      "items": { "$ref": "../cookie.schema.json" }
    },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 120 },
    "headed": { "type": "boolean" },
    "platform": { "type": "string" },
    "trace_id": { "type": "string" }
  },
  "additionalProperties": false
}
