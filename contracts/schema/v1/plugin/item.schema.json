{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dingda://plugin/item/v1",
  "title": "plugin/item",
  "type": "object",
  "required": ["id", "name", "description", "status"],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["not_installed", "downloading", "installed", "failed"]
    },
    "error": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
