{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opendesk://crawler/ipc/keywords_generate.response/v1",
  "title": "crawler/keywords_generate.response",
  "type": "object",
  "required": ["ok", "batch_id", "inserted", "requested", "keywords_json"],
  "properties": {
    "ok": { "type": "boolean" },
    "batch_id": { "type": "string" },
    "inserted": { "type": "integer" },
    "requested": {
      "type": "integer",
      "description": "Expected total = count_per_language * language_count."
    },
    "keywords_json": {
      "type": "string",
      "description": "JSON array string of generated keyword texts."
    },
    "trace_id": { "type": "string" },
    "message": { "type": "string" }
  },
  "additionalProperties": false
}
